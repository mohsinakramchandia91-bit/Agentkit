  {
   "id": "2a89533f-c78b-405d-a475-d80d5911131b",
   "name": "🧠 Build Judge Prompt",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    680,
    560
   ],
   "parameters": {
    "jsCode": "// Webhook fields -> AI scoring prompt\nconst b = $('🌐 Webhook').first().json.body || $('🌐 Webhook').first().json;\nconst prompt = `Score this sales lead 1-10 and reply ONLY valid JSON: {\"score\": <1-10>, \"verdict\": \"<hot|warm|cold>\", \"reason\": \"<one line>\"}.\n\nScoring: clear budget + real business + specific need = high. Vague/tire-kicker = low.\n\nName: ${b.name || '-'}\nEmail: ${b.email || '-'}\nBusiness: ${b.business || '-'}\nBudget: ${b.budget || '-'}\nMessage: ${b.message || '-'}`;\nreturn [{json: {prompt, lead: {name: b.name||'-', email: b.email||'-',\n  business: b.business||'-', budget: b.budget||'-', message: (b.message||'').slice(0,500)}}}];"
   }
  },
  {
   "id": "574b210c-2d3b-4cb8-8436-1604499c7bae",
   "name": "🤖 AI Judge",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    900,
    560
   ],
   "parameters": {
    "method": "POST",
    "url": "={{ $('⚙️ CONFIG').first().json.ai_base_url }}/chat/completions",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "Authorization",
       "value": "=Bearer {{ $('⚙️ CONFIG').first().json.ai_api_key }}"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({model: $('⚙️ CONFIG').first().json.ai_model, temperature: 0.2, messages: [{role: 'system', content: 'You are a strict B2B lead scorer. Reply ONLY with valid JSON, no markdown fences.'}, {role: 'user', content: $json.prompt}]}) }}",
    "options": {
     "timeout": 90000
    }
   }
  },
  {
   "id": "e9535164-7379-4d43-8242-a1e80330b5fd",
   "name": "🔍 Parse Score",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1120,
    560
   ],
   "parameters": {
    "jsCode": "// AI JSON -> score number\nconst raw = $('🤖 AI Judge').first().json;\nlet txt = '';\ntry { txt = raw.choices[0].message.content; } catch(e) { txt = JSON.stringify(raw); }\ntxt = txt.replace(/```json|```/g, '').trim();\nlet score = 0, verdict = 'cold', reason = 'parse failed';\ntry { const j = JSON.parse(txt); score = Number(j.score)||0; verdict = j.verdict||'cold'; reason = j.reason||''; }\ncatch(e) { const m = txt.match(/\"score\"\\s*:\\s*(\\d+)/); if (m) score = Number(m[1]); }\nconst lead = $('🧠 Build Judge Prompt').first().json.lead;\nreturn [{json: {...lead, score, verdict, reason, date: new Date().toISOString()}}];"
   }
  },
  {
   "id": "5c52740b-ef56-4e83-aea0-de96dca5fa90",
   "name": "🔀 Hot?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2,
   "position": [
    1340,
