      }
     ]
    },
    "options": {}
   }
  },
  {
   "id": "0f26549a-c883-4bc7-b0c7-2716f0f806fb",
   "name": "📚 Read Memory",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4.2,
   "position": [
    680,
    560
   ],
   "parameters": {
    "documentId": {
     "__rl": true,
     "mode": "id",
     "value": "={{ $('⚙️ CONFIG').first().json.sheet_id }}"
    },
    "operation": "read",
    "options": {},
    "resource": "sheetWithinDocument",
    "sheetName": {
     "__rl": true,
     "mode": "list",
     "value": "={{ $('⚙️ CONFIG').first().json.memory_tab }}",
     "cachedResultName": "Sheet1"
    }
   }
  },
  {
   "id": "2831a489-6fbd-42d5-80c1-6dfd6a4232e1",
   "name": "🧠 Build Messages",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    900,
    560
   ],
   "parameters": {
    "jsCode": "// Chat memory (Sheets) + naya message -> OpenAI messages array\nconst cfg = $('⚙️ CONFIG').first().json;\nconst tg = $('📩 Telegram Trigger').first().json;\nconst chatId = tg.message.chat.id;\nconst text = (tg.message.text || '').trim();\nconst maxH = Number(cfg.max_history) * 2;\nconst rows = $('📚 Read Memory').all().map(i => i.json)\n  .filter(r => String(r.chat_id) === String(chatId)).slice(-maxH);\nconst messages = [{role: 'system', content: cfg.system_prompt}];\nfor (const r of rows) messages.push({role: r.role, content: r.content});\nmessages.push({role: 'user', content: text});\nreturn [{json: {chat_id: chatId, user_text: text, messages}}];"
   }
  },
  {
   "id": "7b8b7148-5373-400d-ba24-9dd7ab83a918",
   "name": "🤖 AI Chat",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1120,
    560
   ],
   "parameters": {
    "method": "POST",
    "url": "={{ $('⚙️ CONFIG').first().json.ai_base_url }}/chat/completions",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "Authorization",
       "value": "=Bearer {{ $('⚙️ CONFIG').first().json.ai_api_key }}"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({model: $('⚙️ CONFIG').first().json.ai_model, temperature: 0.7, messages: $json.messages}) }}",
    "options": {
     "timeout": 90000
    }
   }
  },
  {
   "id": "5acffa6e-a266-437f-98ab-20482d35f694",
   "name": "💾 Save + Extract",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1340,
    560
   ],
   "parameters": {
    "jsCode": "// AI ka jawab nikalo + memory rows (Sheets append ke liye)\nconst prev = $('🧠 Build Messages').first().json;\nconst out = $('🤖 AI Chat').first().json;\nlet reply = '';\ntry { reply = out.choices[0].message.content; }\ncatch (e) { reply = 'AI se jawab nahi aaya. AI URL/key check karo.'; }\nconst ts = new Date().toISOString();\nreturn [\n  {json: {chat_id: prev.chat_id, role: 'user', content: prev.user_text, ts}},\n  {json: {chat_id: prev.chat_id, role: 'assistant', content: reply, ts}}\n];"
   }
  },
  {
   "id": "f7c8010d-3dc1-4d67-b3fb-8dd6b0e50967",
   "name": "📤 Reply",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    1560,
