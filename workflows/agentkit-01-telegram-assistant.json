       "type": "string",
       "value": "You are a helpful, sharp AI assistant. Be concise, warm, no fluff."
      },
      {
       "id": "c4",
       "name": "sheet_id",
       "type": "string",
       "value": "YOUR_GOOGLE_SHEET_ID"
      },
      {
       "id": "c5",
       "name": "memory_tab",
       "type": "string",
       "value": "memory"
      },
      {
       "id": "c6",
