  {
   "id": "950d8172-1008-42f5-8103-75aac9ccf4fe",
   "name": "📦 Build Pack",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1340,
    500
   ],
   "parameters": {
    "jsCode": "// 4 AI outputs -> aik clean pack (VCM pattern)\nfunction pick(nm) {\n  try {\n    const j = $(nm).first().json;\n    if (j.choices && j.choices[0] && j.choices[0].message) return j.choices[0].message.content;\n    return JSON.stringify(j).slice(0, 4000);\n  } catch (e) { return '[missing: ' + nm + ']'; }\n}\nconst src = $('✂️ Parse Command').first().json;\nreturn [{json: {chat_id: src.chat_id, topic: src.topic,\n  x: pick('🐦 X Thread'), li: pick('💼 LinkedIn Post'),\n  ig: pick('📸 Instagram Caption'), yt: pick('🎬 YouTube Pack'),\n  date: new Date().toISOString()}}];"
   }
  },
  {
   "id": "f6c504a7-10bf-4714-ae40-caa504085158",
   "name": "📤 Send Pack",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    1560,
    500
   ],
   "parameters": {
    "additionalFields": {},
    "chatId": "={{ $json.chat_id }}",
    "text": "=⚡ CONTENT PACK — {{ $json.topic }}\n\n━━━ X THREAD ━━━\n{{ $json.x }}\n\n━━━ LINKEDIN ━━━\n{{ $json.li }}\n\n━━━ INSTAGRAM ━━━\n{{ $json.ig }}\n\n━━━ YOUTUBE ━━━\n{{ $json.yt }}"
   }
  },
