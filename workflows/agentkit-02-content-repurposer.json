    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({model: $('⚙️ CONFIG').first().json.ai_model, temperature: 0.8, messages: [{role: 'system', content: 'You are a viral X (Twitter) copywriter. Punchy, human, never corporate.'}, {role: 'user', content: 'Write a 5-post X thread. Post 1 = hook (under 240 chars). Posts 2-4 = one value idea each. Post 5 = CTA + question. Number 1/5..5/5. Max 2 hashtags, last post only. Topic: ' + $json.topic + ' Tone: ' + $json.tone}]}) }}",
    "options": {
     "timeout": 90000
    }
   }
  },
