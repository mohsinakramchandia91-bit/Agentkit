  {
   "id": "9399a91f-3aa5-4aae-95c3-8424558000c6",
   "name": "✂️ Parse Command",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    680,
    560
   ],
   "parameters": {
    "jsCode": "// /repurpose <topic> se topic nikalo\nconst tg = $('📩 Telegram Trigger').first().json;\nconst text = (tg.message.text || '').trim();\nconst m = text.match(/^\\/repurpose\\s+(.+)/i);\nif (!m) return [{json: {ok: false, chat_id: tg.message.chat.id}}];\nreturn [{json: {ok: true, chat_id: tg.message.chat.id, topic: m[1].trim(),\n  tone: $('⚙️ CONFIG').first().json.default_tone}}];"
   }
  },
  {
   "id": "3608ae33-f851-4c58-bede-a71902ffdb37",
   "name": "🔀 Has Topic?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2,
   "position": [
    900,
    560
   ],
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose"
     },
     "conditions": [
      {
       "id": "c1",
       "leftValue": "={{ $json.ok }}",
       "rightValue": true,
       "operator": {
        "type": "boolean",
        "operation": "true"
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   }
  },
  {
   "id": "bdf5ce72-656a-4f69-8fa2-f9c218e2869d",
