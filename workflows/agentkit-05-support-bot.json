   ],
   "parameters": {
    "updates": [
     "message"
    ],
    "additionalFields": {}
   }
  },
  {
   "id": "a7a70be4-1ff6-4eaa-a12f-56f817bbd9a4",
   "name": "⚙️ CONFIG",
   "type": "n8n-nodes-base.set",
   "typeVersion": 3.4,
   "position": [
    460,
