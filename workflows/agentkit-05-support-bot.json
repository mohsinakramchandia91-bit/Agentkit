       "value": "Iska jawab mere paas nahi hai — WhatsApp pe rabta karein: YOUR_NUMBER"
      }
     ]
    },
    "options": {}
   }
  },
  {
   "id": "b40687a1-a33d-406e-8a71-b63349f8757b",
   "name": "📚 Load KB",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4.2,
   "position": [
    680,
    560
   ],
   "parameters": {
    "documentId": {
     "__rl": true,
     "mode": "id",
     "value": "={{ $('⚙️ CONFIG').first().json.sheet_id }}"
    },
    "operation": "read",
    "options": {},
    "resource": "sheetWithinDocument",
    "sheetName": {
     "__rl": true,
     "mode": "list",
     "value": "={{ $('⚙️ CONFIG').first().json.kb_tab }}",
     "cachedResultName": "Sheet1"
    }
   }
  },
  {
   "id": "2b7f4920-ebf5-474b-8b37-0f8b004535df",
   "name": "🧠 Build Context",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    900,
    560
   ],
   "parameters": {
    "jsCode": "// FAQ rows -> context + user question\nconst cfg = $('⚙️ CONFIG').first().json;\nconst tg = $('📩 Telegram Trigger').first().json;\nconst q = (tg.message.text || '').trim();\nconst kb = $('📚 Load KB').all().map(i => i.json)\n  .filter(r => r.question && r.answer)\n  .map(r => 'Q: ' + r.question + '\\nA: ' + r.answer).join('\\n\\n');\nconst prompt = 'KNOWLEDGE BASE:\\n' + kb + '\\n\\nCUSTOMER QUESTION: ' + q +\n  '\\n\\nAnswer ONLY from the knowledge base above. If the answer is not there, reply EXACTLY: ' + cfg.fallback_text;\nreturn [{json: {chat_id: tg.message.chat.id, question: q, prompt}}];"
   }
  },
  {
   "id": "67b07d60-e791-463e-a180-cd9af9e00c37",
   "name": "🤖 AI Answer",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1120,
    560
   ],
   "parameters": {
    "method": "POST",
    "url": "={{ $('⚙️ CONFIG').first().json.ai_base_url }}/chat/completions",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "Authorization",
       "value": "=Bearer {{ $('⚙️ CONFIG').first().json.ai_api_key }}"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({model: $('⚙️ CONFIG').first().json.ai_model, temperature: 0.1, messages: [{role: 'system', content: 'You are a strict support agent. Never invent facts.'}, {role: 'user', content: $json.prompt}]}) }}",
    "options": {
     "timeout": 90000
    }
   }
  },
  {
   "id": "c654b053-a659-4942-8481-463b4c38512d",
   "name": "✉️ Format Reply",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1340,
    560
   ],
   "parameters": {
    "jsCode": "// Extract + flat log row (Sheets ke liye)\nconst prev = $('🧠 Build Context').first().json;\nconst out = $('🤖 AI Answer').first().json;\nlet a = '';\ntry { a = out.choices[0].message.content; } catch(e) { a = $('⚙️ CONFIG').first().json.fallback_text; }\nreturn [{json: {chat_id: prev.chat_id, reply: a,\n  date: new Date().toISOString(), question: prev.question, answer: a}}];"
   }
  },
  {
   "id": "3755142a-758e-4c85-ad5c-66d6da0b3651",
   "name": "📤 Reply",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
