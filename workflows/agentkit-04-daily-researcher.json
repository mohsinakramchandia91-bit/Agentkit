  {
   "id": "c0fd119a-2ecc-470f-881d-21bdb66285e4",
   "name": "📡 Fetch News",
   "type": "n8n-nodes-base.rssFeedRead",
   "typeVersion": 1,
   "position": [
    680,
    560
   ],
   "parameters": {
    "url": "={{ $('⚙️ CONFIG').first().json.rss_url }}"
   }
  },
  {
   "id": "27ca29a1-e4b7-480b-9e02-7fbc9bc7e0e1",
   "name": "📰 Pick Top Stories",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    900,
    560
   ],
   "parameters": {
    "jsCode": "// Dedupe + top N stories\nconst maxN = Number($('⚙️ CONFIG').first().json.max_items);\nconst seen = new Set(); const picks = [];\nfor (const it of $('📡 Fetch News').all()) {\n  const j = it.json; const t = (j.title || '').trim();\n  if (!t || seen.has(t.toLowerCase())) continue;\n  seen.add(t.toLowerCase());\n  picks.push({title: t, link: j.link || j.url || '', summary: (j.contentSnippet || j.content || '').slice(0, 300)});\n  if (picks.length >= maxN) break;\n}\nconst list = picks.map((p, i) => `${i+1}. ${p.title}\n   ${p.link}\n   ${p.summary}`).join('\\n\\n');\nreturn [{json: {stories: list, count: picks.length, date: new Date().toISOString().slice(0,10)}}];"
   }
  },
  {
   "id": "277b770b-9d24-4e4e-a9bc-aee8933766a4",
   "name": "🤖 AI Digest",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1120,
    560
   ],
   "parameters": {
    "method": "POST",
    "url": "={{ $('⚙️ CONFIG').first().json.ai_base_url }}/chat/completions",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "Authorization",
       "value": "=Bearer {{ $('⚙️ CONFIG').first().json.ai_api_key }}"
      }
     ]
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({model: $('⚙️ CONFIG').first().json.ai_model, temperature: 0.5, messages: [{role: 'system', content: 'You write sharp morning tech digests.'}, {role: 'user', content: 'Write a morning digest in ' + $('⚙️ CONFIG').first().json.digest_language + '. For each story: one-line what happened + one-line why it matters. Keep total under 200 words. Stories:\\n' + $json.stories}]}) }}",
    "options": {
     "timeout": 90000
    }
   }
  },
  {
   "id": "ef5a58f8-5b5d-4e44-9b14-813f8e7e7bc3",
   "name": "✉️ Format Digest",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1340,
    560
   ],
   "parameters": {
    "jsCode": "// AI text -> clean message\nconst out = $('🤖 AI Digest').first().json;\nlet txt = '';\ntry { txt = out.choices[0].message.content; } catch(e) { txt = JSON.stringify(out).slice(0,2000); }\nconst info = $('📰 Pick Top Stories').first().json;\nreturn [{json: {chat_id: $('⚙️ CONFIG').first().json.telegram_chat_id,\n  text: '📰 MORNING DIGEST — ' + info.date + '\\n\\n' + txt,\n  date: info.date, count: info.count}}];"
   }
  },
  {
