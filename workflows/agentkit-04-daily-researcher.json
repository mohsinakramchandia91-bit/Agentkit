   "typeVersion": 1.2,
   "position": [
    240,
    560
   ],
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "days",
       "triggerAtHour": 8,
       "triggerAtMinute": 0
      }
     ]
    }
   }
  },
